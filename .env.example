APP_ENV=development
APP_NAME=YeliSport
API_HOST=0.0.0.0
API_PORT=8000
AI_PORT=8001
POSTGRES_DB=yelisport
POSTGRES_USER=yelisport
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+asyncpg://yelisport:change-me@postgres:5432/yelisport
SUPABASE_URL=http://localhost:54321
SUPABASE_ANON_KEY=change-me
SUPABASE_SERVICE_ROLE_KEY=change-me
JWT_SECRET=change-me
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# Independent football providers; coverage depends on each subscription.
SMS24_API_FOOTBALL_KEY=
SMS24_SPORTMONKS_KEY=

# SMS commercial plans — V1
SMS_COMMERCIAL_PLANS=[{"plan_code":"sms_monthly","name":"SMS Mensuel","description":"Abonnement SMS pour 30 jours","amount_minor":4000,"currency":"XOF","duration_days":30,"active":true,"purchasable":true,"entitlements":{"talent_access":true,"enhanced_profile":true,"discover_visibility":true,"connect_access":true,"statistics_insights":true,"priority_visibility":false}},{"plan_code":"sms_annual","name":"SMS Annuel","description":"Abonnement SMS pour 365 jours","amount_minor":40000,"currency":"XOF","duration_days":365,"active":true,"purchasable":true,"entitlements":{"talent_access":true,"enhanced_profile":true,"discover_visibility":true,"connect_access":true,"statistics_insights":true,"priority_visibility":false}}]

# Internal V1 pilot only; always refused when APP_ENV=production.
SMS_FREE_TEST_PILOT_ENABLED=false
SMS_FREE_TEST_PILOT_PLAN_CODE=sms_monthly
SMS_FREE_TEST_PILOT_DURATION_DAYS=7
